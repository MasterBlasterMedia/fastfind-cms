{
  "name": "fastfind/cms",
  "description": "FastFind: independent Laravel and Vue content management system",
  "type": "project",
  "license": "MIT",
  "require": {"php": "^8.3", "ext-curl": "*", "ext-dom": "*", "ext-fileinfo": "*", "ext-gd": "*", "ext-mbstring": "*", "ext-openssl": "*", "ext-pdo": "*", "ext-sodium": "*", "ext-zip": "*", "composer/semver": "^3.4", "laravel/framework": "^13.0"},
  "require-dev": {"phpunit/phpunit": "^12.0", "nunomaduro/collision": "^8.6", "mockery/mockery": "^1.6"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php artisan test", "check": ["@composer validate --strict", "@composer check-platform-reqs", "@test"]},
  "config": {"sort-packages": true, "preferred-install": "dist", "platform": {"php": "8.3.0"}},
  "minimum-stability": "stable", "prefer-stable": true
}
